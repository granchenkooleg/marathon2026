# Copy to .env and fill with YOUR deployment values. Never commit .env.
# Frontend (CloudFront) URL, no trailing slash, e.g. https://dxxxxxxxxxxxx.cloudfront.net
BASE_URL=
# Backend API Gateway stage URL, no trailing slash, e.g. https://<api-id>.execute-api.<region>.amazonaws.com/develop
API_URL=
# Optional: prefix for every entity the tests create (emails, location addresses, dish names)
TEST_DATA_PREFIX=aqa-e2e

# Optional: Report Portal. The reporter is enabled only when all three are set.
# RP_ENDPOINT=http://localhost:8080/api/v1
# RP_PROJECT=superadmin_personal
# RP_API_KEY=
# RP_LAUNCH=green-tasty-e2e
